{
  "tools": [
    {
      "description": "List the gates of the repository's .sluice.toml: name, command, weight,\ntimeout, hooks and cache flag.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "working_directory": {
            "description": "Absolute path inside the repository (worktree).",
            "type": "string"
          }
        },
        "required": [
          "working_directory"
        ],
        "type": "object"
      },
      "name": "gate_list",
      "outputSchema": {
        "$defs": {
          "GateInfo": {
            "properties": {
              "cache": {
                "description": "Whether passes are cached.",
                "type": "boolean"
              },
              "cmd": {
                "description": "Command, as configured.",
                "type": "string"
              },
              "hooks": {
                "description": "Git hooks the gate belongs to.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "name": {
                "description": "Gate name.",
                "type": "string"
              },
              "timeout_seconds": {
                "description": "Execution timeout in seconds (0 = none).",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "weight": {
                "description": "Budget units the gate occupies while running.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "name",
              "cmd",
              "weight",
              "timeout_seconds",
              "hooks",
              "cache"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "gates": {
            "description": "Gates of `.sluice.toml`, by name.",
            "items": {
              "$ref": "#/$defs/GateInfo"
            },
            "type": "array"
          },
          "repository": {
            "description": "Repository root.",
            "type": "string"
          }
        },
        "required": [
          "repository",
          "gates"
        ],
        "type": "object"
      }
    },
    {
      "description": "Show the last lines of a job log (default: the newest job). Output is\ncapped at 64 KiB; the full log stays on disk at the returned path.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "job_id": {
            "default": null,
            "description": "Job id (as printed by `verify` or `status`). Default: the newest job.",
            "type": [
              "string",
              "null"
            ]
          },
          "tail": {
            "default": null,
            "description": "Number of trailing lines (default 100, max 2000).",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "name": "logs",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "job_id": {
            "description": "Job id.",
            "type": "string"
          },
          "lines": {
            "description": "Trailing lines, oldest first.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "omitted_bytes": {
            "description": "Bytes dropped from the front to keep the output under 64 KiB.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "description": "Log file (the full output stays there).",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "path",
          "lines",
          "omitted_bytes"
        ],
        "type": "object"
      }
    },
    {
      "description": "Approve a ready train (its members land on the target). Humans normally\napprove with `sluice queue approve`; this tool is refused with\n`not-allowed` unless the user enabled `[queue] allow_agent_approval =\ntrue` in the user config. Do not call it unless the user told you to.\nWhen allowed, it waits until the train landed, failed or needs a human\nto reconcile (up to the base's `push_timeout` plus its\n`network_timeout` and a margin), sending progress notifications when\nthe request carries a progressToken.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "train_id": {
            "description": "Train to approve, as shown by `queue_status`.",
            "type": "string"
          },
          "working_directory": {
            "description": "Absolute path inside the repository (worktree).",
            "type": "string"
          }
        },
        "required": [
          "working_directory",
          "train_id"
        ],
        "type": "object"
      },
      "name": "queue_approve",
      "outputSchema": {
        "$defs": {
          "GateSchema": {
            "description": "One gate of a train.",
            "properties": {
              "duration_ms": {
                "description": "Run time in milliseconds.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "gate": {
                "description": "Gate name.",
                "type": "string"
              },
              "job_id": {
                "description": "Sluice job id of the run.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "key": {
                "description": "Cache key on the train's tree.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "description": "`pending`, `running`, `pass`, `cached`, `fail`, `timeout`, `killed`, `error`.",
                "type": "string"
              }
            },
            "required": [
              "gate",
              "status"
            ],
            "type": "object"
          },
          "TrainSchema": {
            "description": "One merge-queue train.",
            "properties": {
              "approved_at": {
                "description": "Approval time.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "approved_via": {
                "description": "`cli` or `mcp`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "base_sha": {
                "description": "Commit the members were merged onto.",
                "type": "string"
              },
              "created_at": {
                "description": "Creation time.",
                "type": "string"
              },
              "gates": {
                "description": "Gates of the train.",
                "items": {
                  "$ref": "#/$defs/GateSchema"
                },
                "type": "array"
              },
              "landed_at": {
                "description": "Landing time.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "members": {
                "description": "Member job ids, in merge order.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "merge_sha": {
                "description": "Landing commit.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "network_timeout_ms": {
                "description": "`[queue] network_timeout` of the base, in milliseconds.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "note": {
                "description": "Free-form note.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "push_timeout_ms": {
                "description": "`[queue] push_timeout` of the base, in milliseconds.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "remote": {
                "description": "Remote of the target; empty for a local target.",
                "type": "string"
              },
              "repo": {
                "description": "Git common dir of the repository.",
                "type": "string"
              },
              "state": {
                "description": "`building`, `verifying`, `ready`, `approved`, `pushing`, `landed`,\n`dissolved`, `needs_reconcile`.",
                "type": "string"
              },
              "target": {
                "description": "Target branch.",
                "type": "string"
              },
              "train_hash": {
                "description": "Hash that approves the train.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "train_id": {
                "description": "Train id.",
                "type": "string"
              },
              "updated_at": {
                "description": "Last state change.",
                "type": "string"
              }
            },
            "required": [
              "train_id",
              "repo",
              "remote",
              "target",
              "base_sha",
              "state",
              "members",
              "gates",
              "created_at",
              "updated_at"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "landed": {
            "description": "True when the train landed on its target.",
            "type": "boolean"
          },
          "state": {
            "description": "Last known train state (`landed`, `dissolved`, `needs_reconcile`, or\n`approved`/`pushing` when the wait timed out).",
            "type": "string"
          },
          "train": {
            "$ref": "#/$defs/TrainSchema",
            "description": "Last known view of the train."
          },
          "train_id": {
            "description": "Train that was approved.",
            "type": "string"
          }
        },
        "required": [
          "train_id",
          "state",
          "landed",
          "train"
        ],
        "type": "object"
      }
    },
    {
      "description": "Cancel a merge-queue job of this repository. A job that is pushing or\nwaiting for reconcile only records the request (it is cancelled once\nnothing landed is proven). Errors start with their code.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "job_id": {
            "description": "Merge-queue job id, as returned by `queue_enqueue` or shown by\n`queue_status`.",
            "type": "string"
          },
          "working_directory": {
            "description": "Absolute path inside the repository (worktree) the job belongs to.",
            "type": "string"
          }
        },
        "required": [
          "working_directory",
          "job_id"
        ],
        "type": "object"
      },
      "name": "queue_cancel",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "attempts": {
            "description": "Attempts so far.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "branch": {
            "description": "Queued branch.",
            "type": "string"
          },
          "caller": {
            "description": "`agent` or `human`.",
            "type": "string"
          },
          "cancel_requested": {
            "description": "A cancel was requested while pushing.",
            "type": "boolean"
          },
          "detail": {
            "description": "Structured detail (conflicting paths, failing gate, ...)."
          },
          "enqueued_at": {
            "description": "Enqueue time (RFC 3339).",
            "type": "string"
          },
          "finished_at": {
            "description": "Terminal time (RFC 3339).",
            "type": [
              "string",
              "null"
            ]
          },
          "head_sha": {
            "description": "Commit captured at enqueue.",
            "type": "string"
          },
          "job_id": {
            "description": "Job id.",
            "type": "string"
          },
          "position": {
            "description": "1-based position among the queued jobs of its target.",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "reason": {
            "description": "Machine-readable reason of the last side exit.",
            "type": [
              "string",
              "null"
            ]
          },
          "remote": {
            "description": "Remote of the target; empty for a local target.",
            "type": "string"
          },
          "repo": {
            "description": "Git common dir of the repository.",
            "type": "string"
          },
          "session": {
            "description": "Agent session identifier.",
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "description": "`queued`, `merging`, `verifying`, `ready`, `approved`, `pushing`,\n`landed`, `conflict`, `failed`, `cancelled`, `needs_reconcile`.",
            "type": "string"
          },
          "target": {
            "description": "Target branch.",
            "type": "string"
          },
          "train_id": {
            "description": "Train the job belongs to, once claimed.",
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "description": "Last state change (RFC 3339).",
            "type": "string"
          },
          "worktree": {
            "description": "Worktree the job was enqueued from.",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "repo",
          "worktree",
          "branch",
          "head_sha",
          "remote",
          "target",
          "state",
          "caller",
          "cancel_requested",
          "attempts",
          "enqueued_at",
          "updated_at"
        ],
        "type": "object"
      }
    },
    {
      "description": "Put a committed branch in the local merge queue (default: the current\nbranch of the worktree). Call it only after `verify` passed on the\ncommitted branch; refuses a detached HEAD and tracked uncommitted\nchanges. Returns the job; then stop and tell the human, who approves the\ntrain with `sluice queue approve`. After a conflict or a failure, fix\nthe branch and call `queue_retry` with the job id (the job keeps the\nbranch). Errors start with their code (`duplicate-branch`,\n`not-supported`, ...).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "base": {
            "default": null,
            "description": "Landing target as `<remote>/<branch>` or a local branch. Default: the\nrepository's configured target.",
            "type": [
              "string",
              "null"
            ]
          },
          "branch": {
            "default": null,
            "description": "Branch to queue. Default: the current branch of the worktree\n(a detached HEAD is refused).",
            "type": [
              "string",
              "null"
            ]
          },
          "working_directory": {
            "description": "Absolute path inside the repository (worktree) whose branch is queued.",
            "type": "string"
          }
        },
        "required": [
          "working_directory"
        ],
        "type": "object"
      },
      "name": "queue_enqueue",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "attempts": {
            "description": "Attempts so far.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "branch": {
            "description": "Queued branch.",
            "type": "string"
          },
          "caller": {
            "description": "`agent` or `human`.",
            "type": "string"
          },
          "cancel_requested": {
            "description": "A cancel was requested while pushing.",
            "type": "boolean"
          },
          "detail": {
            "description": "Structured detail (conflicting paths, failing gate, ...)."
          },
          "enqueued_at": {
            "description": "Enqueue time (RFC 3339).",
            "type": "string"
          },
          "finished_at": {
            "description": "Terminal time (RFC 3339).",
            "type": [
              "string",
              "null"
            ]
          },
          "head_sha": {
            "description": "Commit captured at enqueue.",
            "type": "string"
          },
          "job_id": {
            "description": "Job id.",
            "type": "string"
          },
          "position": {
            "description": "1-based position among the queued jobs of its target.",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "reason": {
            "description": "Machine-readable reason of the last side exit.",
            "type": [
              "string",
              "null"
            ]
          },
          "remote": {
            "description": "Remote of the target; empty for a local target.",
            "type": "string"
          },
          "repo": {
            "description": "Git common dir of the repository.",
            "type": "string"
          },
          "session": {
            "description": "Agent session identifier.",
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "description": "`queued`, `merging`, `verifying`, `ready`, `approved`, `pushing`,\n`landed`, `conflict`, `failed`, `cancelled`, `needs_reconcile`.",
            "type": "string"
          },
          "target": {
            "description": "Target branch.",
            "type": "string"
          },
          "train_id": {
            "description": "Train the job belongs to, once claimed.",
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "description": "Last state change (RFC 3339).",
            "type": "string"
          },
          "worktree": {
            "description": "Worktree the job was enqueued from.",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "repo",
          "worktree",
          "branch",
          "head_sha",
          "remote",
          "target",
          "state",
          "caller",
          "cancel_requested",
          "attempts",
          "enqueued_at",
          "updated_at"
        ],
        "type": "object"
      }
    },
