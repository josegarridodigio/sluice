                "description": "Agent session identifier.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "state": {
                "description": "`queued`, `merging`, `verifying`, `ready`, `approved`, `pushing`,\n`landed`, `conflict`, `failed`, `cancelled`, `needs_reconcile`.",
                "type": "string"
              },
              "target": {
                "description": "Target branch.",
                "type": "string"
              },
              "train_id": {
                "description": "Train the job belongs to, once claimed.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "updated_at": {
                "description": "Last state change (RFC 3339).",
                "type": "string"
              },
              "worktree": {
                "description": "Worktree the job was enqueued from.",
                "type": "string"
              }
            },
            "required": [
              "job_id",
              "repo",
              "worktree",
              "branch",
              "head_sha",
              "remote",
              "target",
              "state",
              "caller",
              "cancel_requested",
              "attempts",
              "enqueued_at",
              "updated_at"
            ],
            "type": "object"
          },
          "TrainSchema": {
            "description": "One merge-queue train.",
            "properties": {
              "approved_at": {
                "description": "Approval time.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "approved_via": {
                "description": "`cli` or `mcp`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "base_sha": {
                "description": "Commit the members were merged onto.",
                "type": "string"
              },
              "created_at": {
                "description": "Creation time.",
                "type": "string"
              },
              "gates": {
                "description": "Gates of the train.",
                "items": {
                  "$ref": "#/$defs/GateSchema"
                },
                "type": "array"
              },
              "landed_at": {
                "description": "Landing time.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "members": {
                "description": "Member job ids, in merge order.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "merge_sha": {
                "description": "Landing commit.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "network_timeout_ms": {
                "description": "`[queue] network_timeout` of the base, in milliseconds.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "note": {
                "description": "Free-form note.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "push_timeout_ms": {
                "description": "`[queue] push_timeout` of the base, in milliseconds.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "remote": {
                "description": "Remote of the target; empty for a local target.",
                "type": "string"
              },
              "repo": {
                "description": "Git common dir of the repository.",
                "type": "string"
              },
              "state": {
                "description": "`building`, `verifying`, `ready`, `approved`, `pushing`, `landed`,\n`dissolved`, `needs_reconcile`.",
                "type": "string"
              },
              "target": {
                "description": "Target branch.",
                "type": "string"
              },
              "train_hash": {
                "description": "Hash that approves the train.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "train_id": {
                "description": "Train id.",
                "type": "string"
              },
              "updated_at": {
                "description": "Last state change.",
                "type": "string"
              }
            },
            "required": [
              "train_id",
              "repo",
              "remote",
              "target",
              "base_sha",
              "state",
              "members",
              "gates",
              "created_at",
              "updated_at"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "jobs": {
            "description": "Jobs, in queue order.",
            "items": {
              "$ref": "#/$defs/JobSchema"
            },
            "type": "array"
          },
          "schema": {
            "description": "Schema version (1).",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "trains": {
            "description": "Trains, oldest first.",
            "items": {
              "$ref": "#/$defs/TrainSchema"
            },
            "type": "array"
          }
        },
        "required": [
          "schema",
          "trains",
          "jobs"
        ],
        "type": "object"
      }
    },
    {
      "description": "Show the Sluice daemon: budget, running and queued jobs, totals (same\nschema as `sluice status --json`; `daemon` is null when none runs). With\n`working_directory`, also the cache state of that tree per gate.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "working_directory": {
            "default": null,
            "description": "Absolute path inside a repository: adds the cache state of its\ncurrent tree per gate and marks that repository's jobs.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "name": "status"
    },
    {
      "description": "Verify the working tree: run the selected gates (cache hit in milliseconds,\notherwise queued in the shared Sluice daemon) and block until every gate\nfinished. Gates run sequentially. Call this before committing instead of\nrunning test, lint or type-check commands yourself. Sends a progress\nnotification every 15 s (configurable) when the request carries a\nprogressToken; without one, the client's idle timeout (30 minutes in\nClaude Code) is the effective limit. The result lists one line per gate\nand, on failure, the tail of the first failing log; `is_error` is set\nwhen any gate did not pass.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "extra_args": {
            "default": null,
            "description": "Arguments appended to every selected gate's command.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "gates": {
            "default": null,
            "description": "Gate names, run in this order. Default: the gates whose `hooks`\ncontain `pre-commit`; when none is tagged, every gate.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "timeout_seconds": {
            "default": null,
            "description": "Execution time limit per gate in seconds, overriding the gate's\n`timeout`. Time spent waiting in the queue does not count.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "working_directory": {
            "description": "Absolute path inside the repository (worktree) to verify.",
            "type": "string"
          }
        },
        "required": [
          "working_directory"
        ],
        "type": "object"
      },
      "name": "verify",
      "outputSchema": {
        "$defs": {
          "GateResult": {
            "properties": {
              "cached": {
                "description": "True when answered from the cache (nothing ran for this call).",
                "type": "boolean"
              },
              "coalesced": {
                "description": "True when this call joined a job another client had already queued.",
                "type": "boolean"
              },
              "duration_ms": {
                "description": "Wall-clock run time in milliseconds (absent for cached passes).",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "exit_code": {
                "description": "Exit code, when the process exited normally.",
                "format": "int32",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "gate": {
                "description": "Gate name.",
                "type": "string"
              },
              "job_id": {
                "description": "Job id (for a cached pass, the job that produced the marker).",
                "type": [
                  "string",
                  "null"
                ]
              },
              "log_path": {
                "description": "Path of the job log.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "description": "Human-readable detail (errors, cancellation).",
                "type": [
                  "string",
                  "null"
                ]
              },
              "not_cached_reason": {
                "description": "Why a pass was not cached, if it was not.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "$ref": "#/$defs/GateStatus",
                "description": "Outcome category."
              },
              "tail": {
                "description": "Last lines of the log of a failing gate (absent when empty).",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "gate",
              "status",
              "cached",
              "coalesced"
            ],
            "type": "object"
          },
          "GateStatus": {
            "description": "Final state of one gate in a `verify` call.",
            "oneOf": [
              {
                "const": "pass",
                "description": "Passed (or a cached pass).",
                "type": "string"
              },
              {
                "const": "fail",
                "description": "Non-zero exit or killed by a foreign signal.",
                "type": "string"
              },
              {
                "const": "timeout",
                "description": "Exceeded its execution timeout.",
                "type": "string"
              },
              {
                "const": "killed",
                "description": "Killed by Sluice (daemon stop, last subscriber gone).",
                "type": "string"
              },
              {
                "const": "error",
                "description": "Sluice itself failed to run the gate.",
                "type": "string"
              },
              {
                "const": "cancelled",
                "description": "The `verify` call was cancelled while this gate was pending.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "all_passed": {
            "description": "True when every gate passed.",
            "type": "boolean"
          },
          "cancelled": {
            "description": "True when the call was cancelled before every gate finished.",
            "type": "boolean"
          },
          "repository": {
            "description": "Repository root.",
            "type": "string"
          },
          "results": {
            "description": "One entry per gate, in run order.",
            "items": {
              "$ref": "#/$defs/GateResult"
            },
            "type": "array"
          }
        },
        "required": [
          "repository",
          "results",
          "all_passed"
        ],
        "type": "object"
      }
    }
  ]
}
