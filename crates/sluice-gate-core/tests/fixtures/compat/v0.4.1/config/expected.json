{
  "full.toml": {
    "defaults": {
      "agent_hook_policy": "fail-fast",
      "human_hook_policy": "wait",
      "tail_lines": 40
    },
    "gates": {
      "lint": {
        "cache": true,
        "cmd": "npm run lint",
        "depends_on": [],
        "env": {},
        "hooks": [
          "pre-commit"
        ],
        "key_files": [],
        "key_inputs": [],
        "timeout_secs": 300.0,
        "weight": 1
      },
      "test": {
        "cache": true,
        "cmd": "npm test -- --maxWorkers=2",
        "depends_on": [
          "lint"
        ],
        "env": {
          "NODE_ENV": "test"
        },
        "hooks": [
          "pre-commit",
          "pre-push"
        ],
        "key_files": [
          ".env.test"
        ],
        "key_inputs": [
          "node --version"
        ],
        "timeout_secs": 1200.0,
        "weight": 4
      }
    },
    "version": 1
  },
